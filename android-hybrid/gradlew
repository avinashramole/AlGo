#!/bin/sh
# Gradle start up script for POSIX generated for Trade 2 Smart hybrid APK.

app_path=$0
while [ -h "$app_path" ]; do
  ls=$(ls -ld "$app_path")
  link=${ls#*' -> '}
  case $link in
    /*) app_path=$link ;;
    *) app_path=$(dirname "$app_path")/$link ;;
  esac
done

APP_HOME=$(cd "$(dirname "$app_path")" && pwd -P) || exit
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
  JAVACMD=$JAVA_HOME/bin/java
  [ -x "$JAVACMD" ] || { echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"; exit 1; }
else
  JAVACMD=java
  command -v java >/dev/null 2>&1 || { echo "ERROR: JAVA_HOME is not set and no java command could be found in PATH."; exit 1; }
fi

exec "$JAVACMD" -Xmx64m -Xms64m $JAVA_OPTS $GRADLE_OPTS \
  -Dorg.gradle.appname=gradlew \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
