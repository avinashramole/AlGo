# Copy to .env or server/.env. Never commit secrets.
DHAN_CLIENT_ID=your-dhan-client-id
DHAN_PIN=your-4-to-6-digit-pin
DHAN_TOTP_SECRET=setup-totp-secret-from-web-dhan-co
# Optional fallback only. PIN + TOTP is what the server uses to change the token.
# DHAN_ACCESS_TOKEN=paste-jwt-from-web-dhan-co

# Linux VPS public site (must match the browser URL)
# PUBLIC_URL=https://trade2smart.com

# Gmail OTP (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Gmail OAuth user login (Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI on the Google client exactly
# Local: http://localhost:4000/api/auth/google/callback
# Live:  https://trade2smart.com/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://trade2smart.com/api/auth/google/callback
# Extra admin Gmails (comma-separated). demo@t2s.app and avinash.ramole86@gmail.com are already admin.
# ADMIN_EMAILS=you@gmail.com

# Optional: bind Segin to this Gmail before first login
# SEGIN_GMAIL=segin@gmail.com
