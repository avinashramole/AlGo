# Copy to .env or server/.env. Never commit secrets.
DHAN_CLIENT_ID=your-dhan-client-id
DHAN_PIN=your-4-to-6-digit-pin
DHAN_TOTP_SECRET=setup-totp-secret-from-web-dhan-co
# Optional fallback only. PIN + TOTP is what the server uses to change the token.
# DHAN_ACCESS_TOKEN=paste-jwt-from-web-dhan-co

# Linux VPS public site (optional; web uses same origin)
# PUBLIC_URL=http://66.116.248.198:4000

# Gmail OTP (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: bind Segin to this Gmail before first login
# SEGIN_GMAIL=segin@gmail.com
