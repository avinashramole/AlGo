[Unit]
Description=Trade 2 Smart API and website
After=network.target
StartLimitIntervalSec=40
StartLimitBurst=12

[Service]
Type=simple
WorkingDirectory=/root/download/algo
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=T2S_HOME=/root/download/algo
EnvironmentFile=-/root/download/algo/.env
EnvironmentFile=-/root/download/algo/tokan.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=2
MemoryMax=1500M
OOMPolicy=stop
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
